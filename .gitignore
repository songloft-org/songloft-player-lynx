# Dependencies
node_modules/

# Build output
dist/
.rspeedy/

# Read-only Flutter reference snapshot (upstream repo songloft-org/songloft-player;
# has its own .git and is NOT part of this project)
songloft-player/

# Claude Code local state (machine-specific): settings + session memory/transcripts.
# NOTE: .claude/skills/ (symlinks into .agents/skills) and CLAUDE.md ARE tracked.
.claude/settings.local.json
.claude/projects/

# CodeGraph index (machine-local, ~46 MB, rebuilt from source by the indexer).
# Committing it would put a per-machine binary artifact in history and conflict on
# every pull. The tooling only needs the directory to exist locally.
.codegraph/

# Logs / OS / editor
*.log
.DS_Store
coverage/
*.tsbuildinfo

# Env
.env
.env.*
!.env.example

# Generated arb→i18next output (produced by scripts/arb-to-i18next.ts; not bundled)
src/i18n/generated/

# Android host build artifacts (Gradle source + wrapper ARE tracked)
android/build/
android/app/build/
android/.gradle/
android/local.properties
android/.cxx/
# Embedded Lynx bundle: a build artifact copied from dist/ by
# scripts/copy-bundle-android.mjs (produced fresh in CI); never commit it.
android/app/src/main/assets/main.lynx.bundle

# iOS host build artifacts (Xcode project, Podfile and Podfile.lock ARE tracked —
# same call as Android: sources + lockfile in, build output out)
ios/Pods/
ios/build/
ios/*.xcworkspace
ios/**/xcuserdata/
ios/**/*.xcuserstate
ios/DerivedData/
# Embedded Lynx bundle: copied from dist/ by scripts/copy-bundle-ios.mjs.
ios/SongloftLynx/main.lynx.bundle

# HarmonyOS host build artifacts (hvigor source IS tracked)
harmony/build/
harmony/entry/build/
harmony/.hvigor/
harmony/local.properties
# Embedded Lynx bundle: copied from dist/ by scripts/copy-bundle-harmony.mjs.
harmony/entry/src/main/resources/rawfile/main.lynx.bundle
# Signing material (never commit keys)
harmony/signing/

.pnpm-store/
bun.lock

# Android signing (local only)
android/key.properties
*.jks
*.keystore

# E2E test artifacts (reports + screenshots — generated per run, not versioned)
e2e/reports/
e2e/screenshots/

# Scratch plans (agent working notes). Anchored to the repo root ON PURPOSE:
# a bare `plans/` matches at ANY depth and silently swallowed `docs/plans/`,
# which IS versioned. Durable plans belong in docs/plans/.
.claude/plans/
/plans/
