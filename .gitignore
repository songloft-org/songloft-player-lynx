# Dependencies
node_modules/

# Build output
dist/
.rspeedy/

# Read-only Flutter reference snapshot (upstream repo songloft-org/songloft-player;
# has its own .git and is NOT part of this project)
songloft-player/

# Claude Code local state (machine-specific): settings + session memory/transcripts.
# NOTE: .claude/skills/ (symlinks into .agents/skills) and CLAUDE.md ARE tracked.
.claude/settings.local.json
.claude/projects/

# Logs / OS / editor
*.log
.DS_Store
coverage/
*.tsbuildinfo

# Env
.env
.env.*
!.env.example

# Generated arb→i18next output (produced by scripts/arb-to-i18next.ts; not bundled)
src/i18n/generated/

# Android host build artifacts (Gradle source + wrapper ARE tracked)
android/build/
android/app/build/
android/.gradle/
android/local.properties
android/.cxx/
# Embedded Lynx bundle: a build artifact copied from dist/ by
# scripts/copy-bundle-android.mjs (produced fresh in CI); never commit it.
android/app/src/main/assets/main.lynx.bundle
