<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Native audio (SongloftAudio / ExoPlayer): background playback + media
         notification / lock-screen controls (roadmap R5). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Background playback keep-alive: allows requesting the user to exempt
         this app from battery optimization so the system does not kill the
         foreground playback service on aggressively-managed ROMs (MIUI etc.). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Floating lyrics overlay (SongloftFloatingLyric / FloatingLyricService).
         Without this declaration the app never appears in "Display over other
         apps", so `Settings.canDrawOverlays()` can only ever return false and the
         user has no way to grant it — the toggle in Settings looks live and does
         nothing. Batch 43 believed this line was already here; it was not. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- `enableOnBackInvokedCallback="false"` pins the back-key dispatch we actually
         implement. With targetSdk 34 that is already the default, so declaring it
         changes nothing today — it states the dependency, and lets
         `android-manifest-contract.test.ts` fail the build if targetSdk moves to 35+
         (where predictive back is opt-out and `MainActivity.onBackPressed` stops being
         called) without migrating to `OnBackInvokedDispatcher`.
         See docs/reference/back-navigation.md. -->
    <application
        android:name=".SongloftApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SongloftLynx"
        android:extractNativeLibs="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="false"
        tools:targetApi="33">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|locale|layoutDirection|smallestScreenSize|screenLayout|density"
            android:theme="@style/Theme.SongloftLynx">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".platform.FilePickerActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:exported="false" />

        <!-- Foreground media service backing background playback + notification.
             The player lives in SongloftAudioEngine; this service hands media3
             the existing MediaSession (see SongloftPlaybackService). -->
        <service
            android:name=".audio.SongloftPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Overlay window holding the current lyric line. Started by
             FloatingLyricModule.show() via startService(); an undeclared service
             cannot be resolved, and `startService` does not throw for that — the
             system logs one "Unable to start service … not found" line and the
             call returns, so the overlay simply never appeared. Deliberately not
             a foreground service: it owns no playback, and the window itself is
             what has to survive *backgrounding* (double-back exit is
             `moveTaskToBack`, which removes no task, so the overlay stays — by
             design).

             `stopWithTask` is the other half of that contract. Removing the task
             (swiping the recents card) leaves the process alive — the media
             playback foreground service pins it — while the LynxView and the JS
             that pushes `updateLyric` die with it. Without this flag the overlay
             outlives the app as a frozen artifact no one can dismiss; with it the
             system stops this service on task removal and `onDestroy` takes the
             window down. -->
        <service
            android:name=".lyric.FloatingLyricService"
            android:exported="false"
            android:stopWithTask="true" />

        <!-- Shares files (the log-export zip) with other apps:
             SongloftPlatformModule.shareFile stages the file under
             cacheDir/shared/ and hands out a content:// URI through this
             provider. `file_paths.xml` declares that one directory; nothing
             else becomes shareable. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
